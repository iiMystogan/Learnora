# Copy this file to .env for local configuration. Never commit the real .env file.
# Production must set NODE_ENV=production and a unique JWT_SECRET of at least 32 characters.
NODE_ENV=development
JWT_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"

# Optional overrides. Upload files must stay outside the publicly served web root.
# PORT=3000
# DATABASE_PATH=./database.sqlite
# UPLOAD_DIR=../Learnora-private-uploads

# Optional: exact client-IP header supplied by a trusted reverse proxy.
# Leave unset unless the proxy overwrites this header and every direct path to the app is trusted.
# TRUSTED_CLIENT_IP_HEADER=x-real-ip
# Do not use X-Forwarded-For unless the entire chain and hop semantics are explicitly verified.
